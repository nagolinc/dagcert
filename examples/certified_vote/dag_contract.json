{
  "schema": "dagcert-contract/v6",
  "workers": [
    {"id": "interface", "concurrency": 1},
    {"id": "ledger", "concurrency": 1},
    {"id": "summarizer", "concurrency": 3},
    {"id": "renderer", "concurrency": 2}
  ],
  "resources": [
    {"id": "snapshot-work", "capacity": 10, "initial": 2, "unit": "snapshots"},
    {"id": "summary-lag", "capacity": 3, "initial": 1, "unit": "generations"}
  ],
  "tasks": [
    {
      "id": "vote.preview",
      "role": "operation",
      "worker": "interface",
      "implementation": {"language": "python", "path": "app.py", "symbol": "preview_vote_total"},
      "outcomes": [
        {"type": "PreviewTotal", "resources": {}, "metadata": {}},
        {"type": "PreviewRejected", "resources": {}, "metadata": {}}
      ],
      "error_budget": {
        "basis": "engineering_assumption",
        "evidence_case": "completion",
        "good_outcomes": ["PreviewTotal"],
        "bad_event_probability_upper": 0.01,
        "minimum_observations": 10
      },
      "external_contract": null,
      "depends_on": [],
      "timings": {
        "completion": {
          "metric": "duration",
          "upper_ms": 16,
          "minimum_samples": 10,
          "safety_factor": 1.3
        }
      }
    },
    {
      "id": "vote.commit",
      "role": "operation",
      "worker": "ledger",
      "implementation": {"language": "python", "path": "app.py", "symbol": "commit_vote_total"},
      "outcomes": [
        {"type": "CommittedTotal", "resources": {"snapshot-work": {"produce": 1}, "summary-lag": {"produce": 1}}, "metadata": {}},
        {"type": "CommitRejected", "resources": {}, "metadata": {}}
      ],
      "error_budget": {
        "basis": "engineering_assumption",
        "evidence_case": "completion",
        "good_outcomes": ["CommittedTotal"],
        "bad_event_probability_upper": 0.01,
        "minimum_observations": 10
      },
      "external_contract": null,
      "depends_on": [{"task": "vote.preview", "outcome_type": "PreviewTotal"}],
      "timings": {
        "completion": {
          "metric": "duration",
          "upper_ms": 50,
          "minimum_samples": 10,
          "safety_factor": 1.3
        }
      }
    },
    {
      "id": "summary.advance",
      "role": "operation",
      "worker": "summarizer",
      "implementation": {"language": "python", "path": "app.py", "symbol": "advance_summary_generation"},
      "outcomes": [
        {"type": "SummaryGeneration", "resources": {"summary-lag": {"consume": 1}}, "metadata": {}}
      ],
      "error_budget": null,
      "external_contract": null,
      "depends_on": [{"task": "vote.commit", "outcome_type": "CommittedTotal"}],
      "timings": {
        "completion": {
          "metric": "duration",
          "upper_ms": 50,
          "minimum_samples": 10
        }
      }
    },
    {
      "id": "snapshot.render",
      "role": "operation",
      "worker": "renderer",
      "implementation": {"language": "python", "path": "app.py", "symbol": "render_vote_snapshot"},
      "outcomes": [
        {"type": "TextSnapshot", "resources": {"snapshot-work": {"consume": 1}}, "metadata": {}}
      ],
      "error_budget": null,
      "external_contract": null,
      "depends_on": [{"task": "vote.commit", "outcome_type": "CommittedTotal"}],
      "timings": {
        "completion": {
          "metric": "duration",
          "upper_ms": 50,
          "minimum_samples": 10
        }
      }
    }
  ],
  "compositions": [
    {
      "id": "vote-cast",
      "steps": [
        {"task": "vote.preview", "timing": "completion", "count": 1, "outcome_type": "PreviewTotal"},
        {"task": "vote.commit", "timing": "completion", "count": 1, "outcome_type": "CommittedTotal"}
      ],
      "metadata": {"horizon": "one preview followed by one commit"}
    }
  ],
  "metadata": {}
}
