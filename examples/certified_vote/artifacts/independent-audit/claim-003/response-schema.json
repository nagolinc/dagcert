{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_packet_sha256",
    "passed",
    "summary",
    "claim_reasoning",
    "rule0_assessment",
    "reviewed_files",
    "strengths",
    "weaknesses",
    "improvements",
    "test_fitting_risks",
    "evidence_gaps",
    "findings"
  ],
  "properties": {
    "audit_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "passed": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 200
    },
    "claim_reasoning": {
      "type": "string",
      "minLength": 200
    },
    "rule0_assessment": {
      "type": "string",
      "minLength": 200
    },
    "reviewed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "subject",
          "recommendation",
          "rationale"
        ],
        "properties": {
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "test_fitting_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "subject",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "evidence",
        "impact"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
